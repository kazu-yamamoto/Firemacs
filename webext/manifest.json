{
    "manifest_version": 2,
    "name": "Firemacs",
    "version": "5.0",
    "description": "Emacs keybindings for Firefox: editing in text fields, scrolling and tabs elsewhere, incremental search and tab switching.",
    "homepage_url": "https://github.com/kazu-yamamoto/Firemacs",
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "96": "icon96.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "@firemacs",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "browser_action": {
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png"
        },
        "default_title": "Firemacs enabled",
        "default_area": "navbar"
    },
    "background": {
        "scripts": ["background.js"],
        "persistent": false
    },
    "permissions": [
        "storage",
        "tabs",
        "search",
        "downloads",
        "menus",
        "clipboardRead",
        "clipboardWrite"
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["defaults.js", "text.js", "visual.js", "minibuffer.js", "content.js"],
            "all_frames": true,
            "run_at": "document_start"
        }
    ]
}
